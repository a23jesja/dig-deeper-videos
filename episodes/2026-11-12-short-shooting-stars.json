  "scenes": [
    {"bg": "night", "narration": "That shooting star you wished on last night? It was a flaming grain of SAND.",
     "chloe": {"action": "wow", "x": 0.3, "say": "Wait... what?", "say_at": 0.6},
     "props": [{"text": "NOT STARS?!", "x": 0.5, "y": 0.24, "size": 88, "anim": "pulse", "at": 0.0, "color": "#ffd23f"},
               {"emoji": "⭐", "x": 0.72, "y": 0.35, "size": 130, "anim": "pop+float", "at": 0.05}]},
    {"bg": "night", "narration": "I'm Sir Digsworth. And yes, I have wished on sand. Twice. Still no PONY.",
     "chloe": {"action": "shrug", "x": 0.3, "say": "Rude.", "say_at": 0.75},
     "props": [{"emoji": "🐴", "x": 0.72, "y": 0.5, "size": 150, "anim": "pop+wobble", "at": 0.7}]},
    {"bg": "space", "narration": "The sand comes from a COMET. Every lap around the Sun, it sheds dust. Like a dog on your sofa.",
     "chloe": {"action": "point", "x": 0.28},
     "props": [{"emoji": "☄️", "x": 0.72, "y": 0.25, "size": 150, "anim": "pop+float", "at": 0.1},
               {"emoji": "🐕", "x": 0.74, "y": 0.8, "size": 130, "anim": "pop+wobble", "at": 0.7}]},
    {"bg": "space", "narration": "Every November, Earth drives straight through that dusty trail. SPLAT.",
     "chloe": {"action": "wow", "x": 0.28},
     "props": [{"emoji": "🌍", "x": 0.72, "y": 0.45, "size": 170, "anim": "pop", "at": 0.1},
               {"text": "SPLAT!", "x": 0.6, "y": 0.24, "size": 100, "anim": "pop", "at": 0.8}]},
    {"bg": "sky", "narration": "And it hits our air FAST. Seventy one kilometers per second.",
     "chloe": {"action": "dizzy", "x": 0.3, "say": "Good heavens!", "say_at": 0.2},
     "props": [{"text": "71 km/s", "x": 0.6, "y": 0.26, "size": 100, "anim": "pop+pulse", "at": 0.55}]},
    {"bg": "sky", "narration": "That's London to Paris in five seconds. Mind the GAP.",
     "chloe": {"action": "jump", "x": 0.28},
     "props": [{"emoji": "🚄", "x": 0.95, "y": 0.5, "size": 150, "anim": "pop+move", "to": [0.62, 0.5], "move_time": 1.2, "at": 0.05}]},
    {"bg": "night", "narration": "The air in front gets squeezed so hard, it GLOWS. That streak is a grain of sand having a very bad day.",
     "chloe": {"action": "think", "x": 0.3},
     "props": [{"emoji": "🔥", "x": 0.72, "y": 0.42, "size": 140, "anim": "pop+pulse", "at": 0.3}]},
    {"bg": "night", "narration": "Don't worry. It burns up a HUNDRED kilometers above your head.",
     "chloe": {"action": "wipe", "x": 0.3, "say": "Phew!", "say_at": 0.55},
     "props": [{"text": "100 km UP", "x": 0.6, "y": 0.26, "size": 90, "anim": "pop", "at": 0.45}]},
    {"bg": "night", "narration": "Want to see thousands? Look up on the night of November SEVENTEENTH.",
     "chloe": {"action": "point", "x": 0.3},
     "fact": {"label": "Look up!", "text": "The Leonid shower peaks on the night of November 17.", "at": 0.35},
     "props": [{"emoji": "✨", "x": 0.72, "y": 0.45, "size": 140, "anim": "pop+float", "at": 0.2}]},
    {"bg": "night", "narration": "My wish? A nice cup of TEA. Results pending.",
